<Window x:Class="TheSingularityWorkshop.SimpleDemos.Minesweeper.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minesweeper — The Singularity Workshop"
        Width="720" Height="790" MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#101827">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="MINESWEEPER" Foreground="#F8FAFC" FontSize="28"
                       FontWeight="Bold" />
            <TextBlock Text="A deterministic game domain. Every move is decided by the same rules engine."
                       Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10"
                Padding="14" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="New board" Click="NewBoard_Click"
                        Padding="18,8" Margin="12,0,0,0" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MINES " Foreground="#94A3B8" FontWeight="Bold" />
                    <TextBlock x:Name="MineCountText" Foreground="#F8FAFC"
                               FontSize="18" FontWeight="Bold" Margin="0,0,22,0" />
                    <TextBlock Text="FLAGS " Foreground="#94A3B8" FontWeight="Bold" />
                    <TextBlock x:Name="FlagCountText" Foreground="#F8FAFC"
                               FontSize="18" FontWeight="Bold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="#0B1220" CornerRadius="12" Padding="12">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <UniformGrid x:Name="Board" Rows="9" Columns="9" Width="540" Height="540" />
            </Viewbox>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#CBD5E1"
                   FontSize="14" FontWeight="SemiBold" Margin="2,16,2,0"
                   Text="Left-click to reveal · Right-click to flag" />
    </Grid>
</Window>
